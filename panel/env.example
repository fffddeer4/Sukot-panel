# ===== SUKOT Panel روی Shiprr =====
# (این مقادیر را در Shiprr: App → Settings → Environment variables وارد کن)

# --- الزامی ---
ADMIN_USERNAME=Sukot
ADMIN_PASSWORD=Sukot
SECRET_KEY=یک-رشته-تصادفی-طولانی
PUBLIC_BASE_URL=https://YOUR-APP.shiprr.app

# --- ذخیره‌سازی دائمی (خیلی مهم — Shiprr دیسک دائمی ندارد) ---
# یک Postgres رایگان از neon.tech یا supabase.com بساز و Connection string را اینجا بگذار
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- ربات تلگرام (اختیاری) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_BOT_USERNAME=SukotBot

# --- Ping / Keep-alive (اختیاری؛ پیش‌فرض روشن) ---
KEEPALIVE_ENABLED=1
KEEPALIVE_INTERVAL=240
# KEEPALIVE_URL=https://YOUR-APP.shiprr.app

# --- پورت کانفیگ‌ها (روی Shiprr از بیرون فقط 443 باز است) ---
SUKOT_TLS=1
SUKOT_FORCE_PORT=443

# --- نیازی به تنظیم نیست (Shiprr خودش PORT را می‌دهد) ---
# PORT=8000
